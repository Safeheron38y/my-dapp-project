# 复制为 .env 仅作参考（服务本身不读取 .env 文件；请用真实环境变量 / 托管平台的 Environment 设置）。切勿提交真实密钥。
PORT=8088
DATA_DIR=./data                 # JSON 持久化目录；off = 关闭持久化
TRUST_PROXY=0                   # 部署在反向代理(Render/Nginx)之后设为 1
# 演示账号（仅演示！）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=Admin@2026!    # 设置后每次启动以它为准；不设则首次启动创建 admin / Admin@2026!
# DEMO_PLAYERS=test01,test02,test03
# DEMO_PLAYER_PASSWORD=Test@2026
# DEMO_PLAYER_BALANCE=10000
# SEED_DEMO=0                   # 不创建演示玩家
# HUIDU（留空 = 使用内置模拟器）
# HUIDU_SIMULATOR=on
# HUIDU_BASE_URL=
# HUIDU_AGENCY_UID=
# HUIDU_AES_KEY=
