# 复制为 .env 仅作参考（服务本身不读取 .env 文件；请用真实环境变量 / 托管平台的 Environment 设置）。切勿提交真实密钥。
PORT=8088
DATA_DIR=./data                 # JSON 持久化目录；off = 关闭持久化
TRUST_PROXY=0                   # 部署在反向代理(Render/Nginx)之后设为 1
# 演示账号（仅演示！）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=Admin@2026!    # 设置后每次启动以它为准；不设则首次启动创建 admin / Admin@2026!
# DEMO_PLAYERS=test01,test02,test03
# DEMO_PLAYER_PASSWORD=Test@2026
# DEMO_PLAYER_BALANCE=10000
# SEED_DEMO=0                   # 不创建演示玩家
# HUIDU：默认使用内置模拟器。真实 HUIDU（Staging/生产）→ 设 HUIDU_MODE=live 并填下面 4 项。
# 本地可把它们写进 .env.local（已 gitignore，服务启动时自动读取；真实环境变量优先）。Render 在 Dashboard → Environment 里填。
# HUIDU_MODE=live                      # live | sim（不设=模拟器；优先于 HUIDU_SIMULATOR）
# HUIDU_SERVER_URL=<server_url>        # 别名 HUIDU_BASE_URL
# HUIDU_AGENCY_UID=<agency_uid>
# HUIDU_AES_KEY=<aes_key 32 chars>
# HUIDU_PLAYER_PREFIX=<player_prefix>  # 别名 HUIDU_ALIAS_PREFIX；member_account 必须以它开头
# HUIDU_CURRENCY=USD
# HUIDU_WALLET_MODE=shared             # shared(seamless) | transfer
# PUBLIC_BASE_URL=https://eightk-platform.onrender.com
# HUIDU_CALLBACK_URL=                  # 可选：覆盖 callback_url
# HUIDU_CALLBACK_IPS=                  # 可选：回调来源 IP 白名单，逗号分隔
# HUIDU_SIMULATOR=on
