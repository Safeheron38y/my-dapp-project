{
  "_comment": "供应商配置。${VAR} 或 ${VAR:-默认值} 会在启动时从环境变量替换。所有 baseUrl/key/secret 均为占位，真实值请放入环境变量或密钥管理系统，切勿提交到仓库。 HUIDU：一个代理账号只能用一种钱包模式(10024)。huidu_seamless 的模式由 HUIDU_WALLET_MODE(shared|transfer) 选择，默认 shared；若同时要两种模式，需要向 HUIDU 申请两个代理账号并启用 huidu_transfer(HUIDU_TRANSFER_* 环境变量)。HUIDU_SIMULATOR=auto：凭据不全时自动使用本地模拟器(离线演示/测试)，on 强制模拟器，off 禁用(凭据不全则启动游戏报 PROVIDER_NOT_CONFIGURED)。",
  "providers": {
    "your_real_provider": {
      "enabled": false,
      "adapter": "_template",
      "label": "（占位）真实供应商",
      "walletMode": "shared",
      "hidden": true,
      "baseUrl": "${REAL_PROVIDER_BASE_URL:-}",
      "apiKey": "${REAL_PROVIDER_API_KEY:-}",
      "secret": "${REAL_PROVIDER_SECRET:-}",
      "currency": "${REAL_PROVIDER_CURRENCY:-CNY}",
      "ipAllowlist": []
    },
    "huidu_seamless": {
      "enabled": true,
      "adapter": "huidu",
      "label": "HUIDU 聚合",
      "walletMode": "${HUIDU_WALLET_MODE:-shared}",
      "baseUrl": "${HUIDU_BASE_URL:-}",
      "apiKey": "${HUIDU_AGENCY_UID:-}",
      "secret": "${HUIDU_AES_KEY:-}",
      "currency": "${HUIDU_CURRENCY:-USD}",
      "aliasPrefix": "${HUIDU_ALIAS_PREFIX:-k8}",
      "simulator": "${HUIDU_SIMULATOR:-auto}",
      "autoTransfer": "${HUIDU_AUTO_TRANSFER:-all}",
      "timeoutMs": 10000,
      "tsToleranceSec": "${HUIDU_TS_TOLERANCE_SEC:-86400}",
      "callbackUrl": "${HUIDU_CALLBACK_URL:-}",
      "ipAllowlist": []
    },
    "huidu_transfer": {
      "enabled": false,
      "adapter": "huidu",
      "label": "HUIDU 聚合（转账钱包）",
      "walletMode": "transfer",
      "hidden": true,
      "baseUrl": "${HUIDU_TRANSFER_BASE_URL:-}",
      "apiKey": "${HUIDU_TRANSFER_AGENCY_UID:-}",
      "secret": "${HUIDU_TRANSFER_AES_KEY:-}",
      "currency": "${HUIDU_CURRENCY:-USD}",
      "aliasPrefix": "${HUIDU_ALIAS_PREFIX:-k8}",
      "simulator": "${HUIDU_SIMULATOR:-auto}",
      "autoTransfer": "${HUIDU_AUTO_TRANSFER:-all}",
      "timeoutMs": 10000,
      "tsToleranceSec": "${HUIDU_TS_TOLERANCE_SEC:-86400}",
      "ipAllowlist": []
    }
  }
}